# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# build output
/dist

# local editor and tooling directories, never committed
/.claude/
/.planning/
/.gsd/

# Upstream World Cities CSV export. It is the generator's input, not a build
# artifact, and it is deliberately not committed: the committed dataset is
# src/data/worldcities/cities.json.
src/data/worldcities/worldcities.csv

# Failure screenshots the browser runner writes, and the attachment copies it
# keeps beside them. Only a red run produces either, and they are evidence of
# that run rather than of this tree.
src/__screenshots__/
/.vitest-attachments/

# What the end-to-end runner writes. The traces and screenshots under
# test-results/ come from failures alone and are evidence of that run rather
# than of this tree; the bookkeeping file beside them is rewritten on every run,
# green included. The configured reporters are list and junit, and the junit one
# names its own output file, so playwright-report/ is still not written: the
# entry is kept so an ad-hoc run asking for the HTML reporter cannot leave a
# committable directory behind.
/test-results
/playwright-report

# The JUnit reports all three suites write for the Codecov upload. Outside
# test-results/, which the end-to-end runner clears before every run, and
# rewritten each time rather than describing this tree.
/junit

# The Chromatic CLI's own artifacts, written into the repository root. The build
# log is named for the archive build script, which is the one this project runs.
chromatic.log
chromatic-diagnostics.json
build-archive.log

# The Wikidata SPARQL result a human downloads with the curl invocation recorded
# in src/data/films/license.md. It is the films generator's input, not a
# committed artifact: the committed dataset is src/data/films/films.json.
scripts/films-result.json
