{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Not implied by strict, and both are aimed at this tree. The first types
    // every index access as possibly undefined, which is what the dataset
    // parser, the page slice and the column lookups all do. The second stops an
    // optional property being written as an explicit undefined, so an absent
    // value and a present undefined stay distinguishable.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    // Was "node", which is node10 resolution and ignores the exports field. The
    // bundler package ships neither a main nor a types field and is reachable
    // only through its exports map, so the compiler could not find the
    // declarations for the programmatic build entry point that the bundle guard
    // imports. This value is the resolution the bundler itself performs.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "./src",
    "plugins": [{ "name": "typescript-plugin-css-modules" }]
  },
  "include": ["src", "vitest.setup.ts", "e2e"]
}
