{
  "name": "yet-another-react-table",
  "version": "0.1.0",
  "description": "Yet Another React Table (YART)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funkadelic/YART.git"
  },
  "homepage": "https://funkadelic.github.io/YART/",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@yart/source": "./src/yart.ts",
      "types": "./lib/types/yart.d.ts",
      "import": "./lib/index.js"
    },
    "./styles.css": {
      "@yart/source": "./src/yart.css",
      "default": "./lib/styles.css"
    }
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "dependencies": {
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "0.15.0",
    "@codecov/bundle-analyzer": "2.0.1",
    "@codspeed/tinybench-plugin": "5.7.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/css-modules": "1.0.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser": "5.0.1",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "axe-core": "4.13.0",
    "chromatic": "18.9.5",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.28.0",
    "fast-check": "4.10.2",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lighthouse": "13.5.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "1.105.0",
    "style-dictionary": "5.5.5",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tinybench": "6.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "typescript-plugin-css-modules": "5.2.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "generate:cities": "node scripts/generate-cities.mjs",
    "generate:films": "node scripts/generate-films.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.{css,scss}\"",
    "lint:fix": "eslint src e2e --fix && stylelint \"src/**/*.{css,scss}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow",
    "test": "vitest run --project=jsdom",
    "test:coverage": "vitest run --project=jsdom --coverage --reporter=default --reporter=junit --outputFile.junit=junit/jsdom.junit.xml",
    "test:watch": "vitest --project=jsdom",
    "test:browser": "vitest run --project=browser --reporter=default --reporter=junit --outputFile.junit=junit/browser.junit.xml",
    "test:e2e": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:mutation": "stryker run",
    "bench": "node --import tsx bench/index.ts",
    "chromatic": "chromatic --playwright",
    "prepare": "husky",
    "prepack": "npm run build:lib"
  }
}
