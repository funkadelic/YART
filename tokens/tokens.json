{
  "primitive": {
    "neutral": {
      "25": { "$type": "color", "$value": "#fbfbfc" },
      "50": { "$type": "color", "$value": "#f4f5f7" },
      "100": { "$type": "color", "$value": "#eceef1" },
      "150": { "$type": "color", "$value": "#e8eaee" },
      "200": { "$type": "color", "$value": "#e3e5e9" },
      "400": { "$type": "color", "$value": "#9aa1ad" },
      "450": { "$type": "color", "$value": "#868c96" },
      "500": { "$type": "color", "$value": "#6a707a" },
      "550": { "$type": "color", "$value": "#656a75" },
      "800": { "$type": "color", "$value": "#262a31" },
      "850": { "$type": "color", "$value": "#22262c" },
      "900": { "$type": "color", "$value": "#1d2127" },
      "925": { "$type": "color", "$value": "#16191e" },
      "950": { "$type": "color", "$value": "#16181d" },
      "975": { "$type": "color", "$value": "#0e1013" }
    },
    "white": { "$type": "color", "$value": "#fff" },
    "teal": {
      "300": { "$type": "color", "$value": "#5ce0d0" },
      "400": { "$type": "color", "$value": "#45cfbf" },
      "700": { "$type": "color", "$value": "#0f7a72" }
    },
    "red": {
      "400": { "$type": "color", "$value": "#f87171" },
      "700": { "$type": "color", "$value": "#b91c1c" }
    },
    "brand-orange": { "$type": "color", "$value": "#f45d48" }
  },
  "color": {
    "surface": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.25}",
        "dark": "{primitive.neutral.975}"
      }
    },
    "surface-raised": {
      "$type": "color",
      "$value": {
        "light": "{primitive.white}",
        "dark": "{primitive.neutral.925}"
      }
    },
    "surface-hover": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.50}",
        "dark": "{primitive.neutral.900}"
      }
    },
    "text": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.950}",
        "dark": "{primitive.neutral.150}"
      }
    },
    "text-muted": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.550}",
        "dark": "{primitive.neutral.400}"
      }
    },
    "border": {
      "$type": "color",
      "$description": "border outlines a container, rule separates rows inside one, and strong bounds a control the reader can press.",
      "$value": {
        "light": "{primitive.neutral.200}",
        "dark": "{primitive.neutral.800}"
      }
    },
    "border-strong": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.450}",
        "dark": "{primitive.neutral.500}"
      }
    },
    "rule": {
      "$type": "color",
      "$value": {
        "light": "{primitive.neutral.100}",
        "dark": "{primitive.neutral.850}"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "light": "{primitive.teal.700}",
        "dark": "{primitive.teal.400}"
      }
    },
    "error": {
      "$type": "color",
      "$value": {
        "light": "{primitive.red.700}",
        "dark": "{primitive.red.400}"
      }
    },
    "focus-ring": {
      "$type": "color",
      "$value": {
        "light": "{primitive.teal.700}",
        "dark": "{primitive.teal.300}"
      }
    },
    "brand": { "$type": "color", "$value": "{primitive.brand-orange}" },
    "brand-contrast": { "$type": "color", "$value": "{primitive.white}" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1-5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "2-5": { "$type": "dimension", "$value": "0.625rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "11": { "$type": "dimension", "$value": "2.75rem" }
  },
  "font-size": {
    "sm": { "$type": "dimension", "$value": "0.875rem" },
    "base": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.125rem" },
    "xl": { "$type": "dimension", "$value": "1.25rem" },
    "2xl": { "$type": "dimension", "$value": "1.5rem" }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$description": "Two steps: sm on a control, md on a container that holds one.",
      "$value": "8px"
    },
    "md": { "$type": "dimension", "$value": "10px" }
  }
}
